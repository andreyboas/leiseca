{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado do usuário autenticado e verificado no Lei Seca.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Identificador único do Firebase Auth.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Endereço de e-mail verificado do usuário.",
          "minLength": 3,
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "description": "Nome de exibição do usuário.",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "URL HTTPS opcional da foto de perfil.",
          "minLength": 8,
          "maxLength": 500,
          "pattern": "^https://.*"
        },
        "provider": {
          "type": "string",
          "enum": ["google", "password"],
          "description": "Provedor utilizado na autenticação."
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Confirmação de verificação de e-mail."
        },
        "escalaFonteInterface": {
          "type": "number",
          "description": "Escala percentual padrão das fontes da interface do usuário (100 a 135)."
        },
        "tamanhoFonteLeitor": {
          "type": "number",
          "description": "Tamanho padrão da fonte no leitor de artigos em pixels (16 a 26)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor na criação do perfil."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor na última atualização."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "provider",
        "emailVerified",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Armazena o perfil privado de cada usuário autenticado com e-mail verificado."
    }
  }
}
