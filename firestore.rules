rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'provider',
          'emailVerified',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'provider',
          'emailVerified',
          'photoURL',
          'escalaFonteInterface',
          'tamanhoFonteLeitor',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 320
        && request.auth.token.email is string
        && data.email == request.auth.token.email
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.provider is string
        && data.provider in ['google', 'password']
        && data.emailVerified is bool
        && data.emailVerified == true
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() >= 8 && data.photoURL.size() <= 500 && data.photoURL.matches('^https://.*')))
        && (!('escalaFonteInterface' in data) || (data.escalaFonteInterface is number && data.escalaFonteInterface >= 100 && data.escalaFonteInterface <= 135))
        && (!('tamanhoFonteLeitor' in data) || (data.tamanhoFonteLeitor is number && data.tamanhoFonteLeitor >= 16 && data.tamanhoFonteLeitor <= 26))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId) && isEmailVerified();
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().provider == existing().provider
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'emailVerified',
          'escalaFonteInterface',
          'tamanhoFonteLeitor',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId) && isEmailVerified();
    }
  }
}
